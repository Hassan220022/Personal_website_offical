# --- Chatbot LLM provider (OpenAI-compatible endpoint) ---------------------
# NEVER use OpenRouter or Google directly. Use an OpenAI-compatible base URL
# via OPENAI_* or NINEROUTER_* (NINEROUTER is the self-hosted 9Router/OmniRoute).
OPENAI_BASE_URL=https://your-openai-compatible-endpoint/v1
OPENAI_API_KEY=your_openai_api_key_here
# OR
NINEROUTER_BASE_URL=https://your-ninerouter-endpoint/v1
NINEROUTER_KEY=your_ninerouter_key_here
# Override model explicitly; defaults to glm-5.2 ONLY when a provider is set.
CHAT_MODEL=glm-5.2
# Request timeout in milliseconds (default 25000).
CHAT_TIMEOUT_MS=25000

# --- GitHub API (optional, higher rate limits) -----------------------------
GITHUB_TOKEN=your_github_token_here
GITHUB_USERNAME=Hassan220022

# --- Application -----------------------------------------------------------
NODE_ENV=development
